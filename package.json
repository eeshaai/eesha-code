{
  "name": "@eeshaai/code",
  "version": "1.2.0",
  "description": "A chat with AI coding agents in a browser tab, served by a small server on your own machine. Claude, Copilot, Kiro and more.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "Santosh Jallapuram",
  "repository": {
    "type": "git",
    "url": "https://github.com/eeshaai/eesha-code"
  },
  "bin": {
    "eesha": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.css",
    "dist/**/*.html",
    "dist/resources/**",
    "dist/claude-agent-sdk/sdk.mjs",
    "dist/claude-agent-sdk/LICENSE.md",
    "dist/THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "node build.js",
    "prepack": "node build.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "node build.js && playwright test",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "koffi": "^3.2.1"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.5.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@github/copilot-sdk": "^1.0.14",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "mermaid": "^11.17.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sass": "^1.105.0",
    "serilogger": "^0.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "npm@11.1.0"
}
